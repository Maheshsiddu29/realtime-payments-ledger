# Copy to .env and adjust for local development: cp .env.example .env
# docker-compose.yml reads these values, falling back to the defaults shown.

# ---- Application ----
APP_NAME=payments-ledger
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# ---- HTTP ----
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- gRPC (application API) ----
GRPC_HOST=0.0.0.0
GRPC_PORT=9090
GRPC_SHUTDOWN_TIMEOUT=15s
# Server reflection: handy for grpcurl in development, refused in production.
GRPC_REFLECTION=true

# ---- JWT verification ----
# This service VERIFIES access tokens; it does not issue them. Only a public
# key is configured, so a compromise here cannot forge a token.
# Generate a development key and token with: make devtoken
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem
JWT_LEEWAY=30s

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=25
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONNECT_TIMEOUT=10s

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=3s
REDIS_COMMAND_TIMEOUT=1s

# ---- Idempotency ----
# Redis-side lifetimes only. Expiry never weakens deduplication: the UNIQUE
# constraint on transfers.idempotency_key is the final barrier and has no TTL.
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_PROCESSING_TTL=30s

# ---- Kafka ----
KAFKA_BROKERS=localhost:29092
KAFKA_AUDIT_TOPIC=ledger.audit.v1
